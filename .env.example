# Which provider the worksheet reader uses: "featherless" (default) or "claude".
MODEL_PROVIDER=featherless

# --- Featherless (default) -------------------------------------------------
# Redeem promo code SUVIDHA26 for $25 of request credits (no card required).
# Keys are created under Profile -> API Keys.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Analysis runs in two stages, because the strongest models on Featherless are
# text-only and a mid-size vision model got the arithmetic wrong. A vision model
# only transcribes the photo; a frontier text model does all the reasoning.
# Typed or pasted worksheets skip the vision stage entirely.
#
# Stage 2 — the reasoning. Correctness lives or dies here.
FEATHERLESS_REASONING_MODEL=zai-org/GLM-5.2

# Stage 1 — transcription only. Optional; leave blank to use the built-in chain.
#
# Featherless serves models on demand, and any single model can return
# "This model is busy, please try again later" without warning. The adapter
# therefore walks a fallback chain rather than trusting one id; whatever you
# set here is tried first and the built-in chain backs it up.
#
# Comma-separated values are allowed to put several models ahead of the chain.
FEATHERLESS_VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct

# --- Claude (swap in with MODEL_PROVIDER=claude) ---------------------------
ANTHROPIC_API_KEY=
