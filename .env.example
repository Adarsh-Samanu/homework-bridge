# Which provider the worksheet reader uses: "featherless" (default) or "claude".
MODEL_PROVIDER=featherless

# --- Featherless (default) -------------------------------------------------
# Your $25 hackathon credit is issued against the Google form registration.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# Must be an image-capable model. Check the current Featherless catalog and
# paste the exact id — a text-only model here fails at request time.
FEATHERLESS_VISION_MODEL=

# --- Claude (swap in with MODEL_PROVIDER=claude) ---------------------------
ANTHROPIC_API_KEY=
